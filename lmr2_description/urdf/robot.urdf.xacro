<?xml version="1.0"?>

<robot name="lmr2"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- instantiate macros and properties -->
    <xacro:include filename="$(find lmr2_description)/urdf/common/properties.xacro"/>
    <xacro:include filename="$(find lmr2_description)/urdf/common/inertials.xacro"/>

    <!-- instantiate fixed components -->
    <xacro:include filename="$(find lmr2_description)/urdf/components/base.xacro"/>
    <xacro:include filename="$(find lmr2_description)/urdf/components/wheel.xacro"/>
    <xacro:include filename="$(find lmr2_description)/urdf/components/caster.xacro"/>
    <xacro:include filename="$(find lmr2_description)/urdf/components/sensors.xacro"/>
    <xacro:include filename="$(find lmr2_description)/urdf/components/camera.xacro"/>
    <xacro:include filename="$(find lmr2_description)/urdf/components/camera_optical.xacro"/>

    <!-- left wheel -->
    <xacro:wheel
        prefix="left"
        parent="base_link"
        xyz="0 ${wheel_offset_y} ${wheel_offset_z}"
        rpy="-${PI/2} 0 0"
        mesh_file="package://lmr2_description/meshes/visuals/wheel.dae"
        axis="0 0 1"/>

    <!-- right wheel -->
    <xacro:wheel
        prefix="right"
        parent="base_link"
        xyz="0 -${wheel_offset_y} ${wheel_offset_z}"
        rpy="${PI/2} 0 0"
        mesh_file="package://lmr2_description/meshes/visuals/wheel.dae"
        axis="0 0 -1"/>

    <!-- left camera -->
    <xacro:camera
        prefix="left"
        parent="base_link"
        xyz="${camera_offset_x} ${camera_offset_y} ${camera_offset_z}"
        rpy="0 0.175 0"/>

    <!-- right camera -->
    <xacro:camera
        prefix="right"
        parent="base_link"
        xyz="${camera_offset_x} -${camera_offset_y} ${camera_offset_z}"
        rpy="0 0.175 0"/>

    <!-- left camera -->
    <xacro:camera_optical
        prefix="left"/>

    <!-- right camera -->
    <xacro:camera_optical
        prefix="right"/>

    <!-- Gazebo Harmonic systems -->
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${2.0 * wheel_offset_y}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <!-- Keep Gazebo native and ROS bridge topic names stable. -->
        <topic>/lmr2/cmd_vel</topic>
        <odom_topic>/lmr2/odom</odom_topic>
        <tf_topic>/lmr2/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
        <max_linear_velocity>0.8</max_linear_velocity>
        <max_angular_velocity>4.0</max_angular_velocity>
      </plugin>

      <!-- Gazebo is the ONLY joint state source in simulation. -->
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/lmr2/joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
      </plugin>
    </gazebo>

    <!-- Retain fixed sensor joints so their frame names and sensor poses survive URDF2SDF conversion. -->
    <gazebo reference="lidar_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
    <gazebo reference="imu_joint"><preserveFixedJoint>true</preserveFixedJoint></gazebo>

    <gazebo reference="left_wheel_link">
      <mu1>2.0</mu1><mu2>2.0</mu2>
    </gazebo>
    <gazebo reference="right_wheel_link">
      <mu1>2.0</mu1><mu2>2.0</mu2>
    </gazebo>
    <gazebo reference="caster_wheel_link">
      <mu1>0.6</mu1><mu2>0.6</mu2>
    </gazebo>

    <!-- LD19 LiDAR approximation, based on original 450 ray / 10 Hz / 12m model. -->
    <gazebo reference="lidar_link">
      <sensor name="ld19_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <topic>/lmr2/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan><horizontal>
            <samples>450</samples><resolution>1</resolution>
            <min_angle>-${PI}</min_angle><max_angle>${PI}</max_angle>
          </horizontal></scan>
          <range><min>0.2</min><max>12.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </gazebo>

    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/lmr2/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <gazebo reference="right_camera_link">
        <sensor name="stereo_camera_right" type="camera">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <camera>
                <camera_info_topic>/lmr2/stereo_camera/right/camera_info</camera_info_topic>
                <horizontal_fov>1.274</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>20.0</far>
                </clip>
            </camera>
            <topic>/lmr2/stereo_camera/right/image_raw</topic>
            <gz_frame_id>right_camera_link_optical</gz_frame_id>
        </sensor>
    </gazebo>

    <gazebo reference="left_camera_link">
        <sensor name="stereo_camera_left" type="camera">
            <pose> 0 0 0 0 0 0 </pose>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <camera>
                <camera_info_topic>/lmr2/stereo_camera/left/camera_info</camera_info_topic>
                <horizontal_fov>1.274</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>20.0</far>
                </clip>
            </camera>
            <topic>/lmr2/stereo_camera/left/image_raw</topic>
            <gz_frame_id>left_camera_link_optical</gz_frame_id>
        </sensor>
    </gazebo>

</robot>
