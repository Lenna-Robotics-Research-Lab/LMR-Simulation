<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ======================== -->
    <!-- IMU -->
    <!-- ======================== -->

    <link name="imu_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <mass value="0.010"/>

            <xacro:box_inertia
                mass="0.010"
                length="0.005"
                width="0.005"
                height="0.005"/>

        </inertial>
    </link>

    <joint name="imu_joint"
           type="fixed">

        <origin
            xyz="${imu_offset_x}
                 ${imu_offset_y}
                 ${imu_offset_z}"
            rpy="0 0 0"/>

        <parent link="base_link"/>
        <child link="imu_link"/>

    </joint>

    <!-- ======================== -->
    <!-- LiDAR -->
    <!-- ======================== -->

    <link name="lidar_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <mass value="0.100"/>

            <xacro:cylinder_inertia
                mass="0.100"
                radius="0.025"
                length="0.035"/>
        </inertial>
    </link>

    <joint name="lidar_joint"
           type="fixed">

        <origin
            xyz="${lidar_offset_x}
                 ${lidar_offset_y}
                 ${lidar_offset_z}"
            rpy="0 0 0"/>

        <parent link="base_link"/>
        <child link="lidar_link"/>

    </joint>

</robot>