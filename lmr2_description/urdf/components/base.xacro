<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="base_link">

        <inertial>
            <origin
                xyz="${base_offset_x}
                     ${base_offset_y}
                     ${base_offset_z}"
                rpy="0 0 0"/>

            <mass value="${base_mass}"/>

            <xacro:box_inertia
                mass="${base_mass}"
                length="${base_length}"
                width="${base_width}"
                height="${base_height}"/>
        </inertial>

        <visual>
            <origin
                xyz="0 0 0"
                rpy="0 0 0"/>

            <geometry>
                <mesh filename="package://lmr2_description/meshes/visuals/lmr2_base.dae"/>
            </geometry>
        </visual>

        <collision>
            <origin
                xyz="0 0 0"
                rpy="0 0 0"/>

            <geometry>
                <mesh filename="package://lmr2_description/meshes/collisions/lmr2_base.stl"/>
            </geometry>
        </collision>

    </link>

    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

</robot>
