<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="camera"
                 params="
                 prefix
                 parent
                 xyz
                 rpy">

        <link name="${prefix}_camera_link">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <mass value="0.010"/>

                <xacro:box_inertia
                    mass="0.010"
                    length="0.005"
                    width="0.005"
                    height="0.005"/>

            </inertial>
        </link>

        <joint name="${prefix}_camera_joint"
               type="fixed">

            <origin xyz="${xyz}"
                    rpy="${rpy}"/>

            <parent link="${parent}"/>
            <child link="${prefix}_camera_link"/>

        </joint>

    </xacro:macro>

</robot>